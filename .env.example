APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Prefer sqlite for Phase 1 local testing; switch to postgres via DATABASE_URL for scale-out
DATABASE_URL=sqlite+aiosqlite:///./nexus.db
# For sync tools / alembic fallback
DATABASE_URL_SYNC=sqlite:///./nexus.db

# Secret for JWT — generate a strong random value for real deployments
SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Ollama nodes — add OLLAMA_NODE_3_* etc for future scaling without code changes
OLLAMA_NODE_1_URL=http://local-ip-address:11434
OLLAMA_NODE_1_MODEL=qwen3:1.7b
OLLAMA_NODE_1_ENABLED=true

OLLAMA_NODE_2_URL=http://local-ip-address:11434
OLLAMA_NODE_2_MODEL=qwen3.5:0.8b
OLLAMA_NODE_2_ENABLED=true

AI_DEFAULT_NODE=node1
AI_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_CONTEXT_TOKENS=8192
AI_MAX_CONCURRENT_REQUESTS_PER_NODE=1
AI_FALLBACK_ENABLED=true
AI_NUM_CTX=4096
# Phase 2A file pipeline (AGENTS §8)
FILE_SMALL_TOKEN_THRESHOLD=4000
FILE_MEDIUM_TOKEN_THRESHOLD=12000
FILE_MAX_SIZE_BYTES=10485760

# Logging
LOG_LEVEL=INFO
LOG_SENSITIVE_CONTENT=false
